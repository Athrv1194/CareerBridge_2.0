# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored (**/.env in .gitignore); this template is not. Never put a real secret in
# THIS file. docker-compose.yml reads every variable below -- the ones written ${VAR:?...} there
# abort `docker compose up` with a named error if unset, rather than starting a container with an
# empty password and failing somewhere less obvious.


# ---------------------------------------------------------------------------------------------
# PostgreSQL  (auth, student, assessment, recommendation, notification)
# ---------------------------------------------------------------------------------------------

# Superuser for the postgres container. Also becomes SPRING_DATASOURCE_USERNAME for all five
# services. Optional -- defaults to "postgres" if omitted.
POSTGRES_USER=postgres

# REQUIRED. Sets the container's superuser password AND every service's
# SPRING_DATASOURCE_PASSWORD, so they cannot drift apart.
# Unrelated to the password in each service's gitignored application-local.yml: that file is
# excluded from the images by .dockerignore and never reaches a container.
POSTGRES_PASSWORD=change-me


# ---------------------------------------------------------------------------------------------
# RabbitMQ  (auth, student, recommendation, notification)
# ---------------------------------------------------------------------------------------------

# Optional -- defaults to "careerbridge". Do NOT set this to "guest": RabbitMQ permits the
# built-in guest account on loopback connections only, and inside the compose network every
# service connects from its own container IP, so all four consumers would be refused with
# ACCESS_REFUSED. Any other username has no such restriction. This differs from the guest/guest
# in each service's application.yml, which is for a broker running on the developer's own host.
RABBITMQ_USER=careerbridge

# REQUIRED. Sets the broker's user AND all four services' SPRING_RABBITMQ_PASSWORD from one value,
# so they cannot drift. Also the login for the management UI at http://localhost:15672.
# Applied when the broker first initialises its database: changing it later has no effect until
# `docker compose down -v` (destroys queue state) or an explicit rabbitmqctl change_password.
RABBITMQ_PASSWORD=change-me


# ---------------------------------------------------------------------------------------------
# JWT  (auth-service signs, api-gateway verifies)
# ---------------------------------------------------------------------------------------------

# REQUIRED. One value, two containers -- auth-service reads it as jwt.secret and api-gateway as
# gateway.jwt-secret. Setting it for one and not the other fails every authenticated request with
# a signature error.
#
# MUST be at least 49 bytes. jjwt's Keys.hmacShaKeyFor picks the strongest HMAC the key length
# allows, and 49 bytes = 392 bits selects HS384. Shorter keys silently select HS256 or throw
# WeakKeyException below 32 bytes; the algorithm is never named in code on either side, so a
# shortened secret changes the signing algorithm rather than producing an obvious error.
# The value below is exactly 49 characters -- keep any replacement at 49 or more.
JWT_SECRET=your-256-bit-secret-key-here-change-in-production


# ---------------------------------------------------------------------------------------------
# MongoDB Atlas  (notification-service only -- no container, this is a cloud cluster)
# ---------------------------------------------------------------------------------------------

# REQUIRED for notification-service. The URI embeds its own database user and password, which is
# why it can only live here and in the gitignored application-local.yml.
# Binds to spring.mongodb.uri -- NOT spring.data.mongodb.uri, which Boot 4 deprecated at level
# "error" and therefore neither binds nor warns about.
# There is no default: application.yml falls back to mongodb://localhost:27017, and inside the
# container localhost is the container itself. The driver connects lazily, so a wrong value here
# starts cleanly and only fails when the first recommendation.generated event arrives.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerbridge_notifications?appName=CareerBridge


# ---------------------------------------------------------------------------------------------
# Gmail SMTP  (notification-service only)
# ---------------------------------------------------------------------------------------------

# The sending account. Mapped to MAIL_USERNAME, which is what application.yml reads.
GMAIL_USERNAME=your.address@gmail.com

# A Gmail APP PASSWORD, not the account password -- the account password will not authenticate.
# Requires 2FA enabled on the account. Google shows it as four space-separated groups; the actual
# secret is the 16 characters with the spaces removed. Mapped to MAIL_PASSWORD.
# Both may be left empty: the context still starts, email delivery is what fails.
GMAIL_APP_PASSWORD=


# ---------------------------------------------------------------------------------------------
# AI Coach external APIs  (ai-coach-service only)
# ---------------------------------------------------------------------------------------------
#
# All three are OPTIONAL and written ${VAR:-} in docker-compose, unlike the REQUIRED entries above.
# ai-coach-service checks StringUtils.hasText on every key before calling out: with a key unset the
# service starts clean, the chat endpoint answers 503 with a clear message rather than an opaque
# upstream 401, and the resource-catalog refresh logs a warning and enriches nothing. Making any of
# them ${VAR:?} would break `docker compose up` for every teammate who has not obtained keys yet.
#
# ai-coach-service reuses MONGODB_URI above -- same Atlas cluster, different database, redirected by
# spring.mongodb.database=careerbridge_ai_coach rather than a second connection string.

# Groq -- powers the career-coach chat (Feature B). Free tier, no credit card: 14,400 req/day.
# Dashboard: https://console.groq.com
GROQ_API_KEY=

# Optional model override. Groq deprecates and renames models fairly often, so this is a config
# value rather than a constant -- a rename is an env change, not a rebuild.
# GROQ_MODEL=llama-3.3-70b-versatile

# Tavily -- finds up to 4 of the 5 study resources per milestone (Feature A). Free: 1,000
# credits/month. Dashboard: https://app.tavily.com
TAVILY_API_KEY=

# YouTube Data API v3 -- finds the 1 video per milestone (Feature A). Free: 10,000 units/day, and
# a search costs 100 units, so 100 searches/day. The whole catalog is 47 milestones enriched ONCE
# (shared across all students on a career path), so this fits comfortably inside a single day.
# Setup: Google Cloud Console -> enable YouTube Data API v3 -> create an API key.
YOUTUBE_API_KEY=
